<Project Sdk="MSTest.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LibraryFramework Condition="'$(LibraryFramework)' == ''">net8.0</LibraryFramework>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <ProjectReference Include="../../TinyEXR.NET/TinyEXR.NET.csproj" SetTargetFramework="TargetFramework=$(LibraryFramework)" SkipGetTargetFrameworkProperties="true" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>
</Project>
