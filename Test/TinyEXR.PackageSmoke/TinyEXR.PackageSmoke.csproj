<Project Sdk="MSTest.Sdk">
  <PropertyGroup>
    <EnableMSTestSourceGeneration>true</EnableMSTestSourceGeneration>
    <MSTestSourceGenMode>ReflectionFree</MSTestSourceGenMode>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup><Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" /></ItemGroup>
  <ItemGroup><PackageReference Include="TinyEXR.NET" Version="[1.2.0]" /></ItemGroup>
</Project>
